# 로컬 개발용 예시이며 실제 비밀값과 운영 DB 주소를 작성하지 않습니다.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moving?schema=public
CORS_ORIGINS=http://localhost:3000

ACCESS_TOKEN_SECRET=replace-with-at-least-32-character-access-secret
REFRESH_TOKEN_SECRET=replace-with-at-least-32-character-refresh-secret
ACCESS_TOKEN_MAX_AGE_MS=1800000
REFRESH_TOKEN_MAX_AGE_MS=604800000
JWT_ISSUER=moving-api

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
SWAGGER_ENABLED=true

# OAuth는 후속 작업에서 공급자 콘솔 값을 발급받은 뒤 사용합니다.
FRONTEND_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
