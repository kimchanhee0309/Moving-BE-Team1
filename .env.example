# 이 파일을 .env로 복사한 뒤 Secret과 DB 접속 정보는 각자 로컬 값으로 교체합니다.
# 실제 Secret, OAuth 자격 증명, 운영 DB 주소는 Git에 커밋하지 않습니다.

# Server and database
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# OAuth: 각 공급자 개발자 Console에서 발급한 팀 설정을 안전한 채널로 공유합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT and password reset: 아래 예시를 실제 32바이트 이상 무작위 값으로 교체합니다.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
PASSWORD_RESET_TOKEN_SECRET=replace-with-at-least-32-characters
PASSWORD_RESET_CODE_SECRET=replace-with-random-64-character-hex
JWT_ISSUER=moving-api

# Local password reset delivery
# console: development 전용이며 백엔드 터미널에서 코드를 확인합니다.
# smtp: 실제 메일을 발송하며 아래 SMTP_* 값을 모두 설정해야 합니다.
PASSWORD_RESET_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Profile image storage
# local: 서버 디스크의 /uploads에 저장합니다(로컬 개발 기본값, AWS 설정 불필요).
# s3: 비공개 S3 버킷에 저장하고 CloudFront 주소를 DB에 저장합니다. 아래 AWS_BUCKET_NAME, CLOUDFRONT_DOMAIN이 필수입니다.
PROFILE_IMAGE_STORAGE=local
AWS_REGION=ap-northeast-2
AWS_BUCKET_NAME=
# https://와 경로를 뺀 CloudFront 배포 도메인만 적습니다. 예: d1234abcd.cloudfront.net
CLOUDFRONT_DOMAIN=
# 버킷에 s3:PutObject, s3:DeleteObject만 허용된 IAM 사용자 키입니다. EC2에 IAM Role을 연결했다면 비워 둡니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Authentication cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_MAX_AGE_MS=1800000
REFRESH_TOKEN_MAX_AGE_MS=604800000
TRUST_PROXY=false
SWAGGER_ENABLED=true
